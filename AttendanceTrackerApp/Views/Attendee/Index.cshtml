@model IEnumerable<AttendanceTrackerApp.Models.Attendee>

@{
    ViewData["Title"] = "Attendees";
}

<h2>Attendees</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add Attendee</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Employee ID</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendee in Model)
        {
            <tr>
                <td>@attendee.FullName</td>
                <td>@attendee.EmployeeId</td>
                <td>@attendee.Email</td>
            </tr>
        }
    </tbody>
</table>
