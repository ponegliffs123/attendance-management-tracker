@model AttendanceTrackerApp.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2>Attendance Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white p-3">
            <h5>Events</h5>
            <h3>@Model.Events.Count</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white p-3">
            <h5>Attendees</h5>
            <h3>@Model.Attendees.Count</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white p-3">
            <h5>Recent Check-Ins</h5>
            <h3>@Model.RecentAttendance.Count</h3>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h4>Upcoming Events</h4>
        <ul class="list-group">
            @foreach (var item in Model.Events)
            {
                <li class="list-group-item">
                    <strong>@item.Name</strong><br />
                    @item.EventDate.ToString("ddd, dd MMM yyyy")<br />
                    @item.Location
                </li>
            }
        </ul>
    </div>

    <div class="col-md-6">
        <h4>Recent Attendance</h4>
        <ul class="list-group">
            @foreach (var item in Model.RecentAttendance)
            {
                <li class="list-group-item">
                    <strong>@item.Attendee?.FullName</strong> checked in for <strong>@item.Event?.Name</strong>
                    <br />
                    @item.CheckInTime.ToString("g")
                </li>
            }
        </ul>
    </div>
</div>
